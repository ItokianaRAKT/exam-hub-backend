# Copier en ".env" puis adapter. Ne jamais committer ".env".

# URL PostgreSQL managée (Neon / Supabase / Render…)
DATABASE_URL=postgresql://user:password@host:5432/database

# Noms/identifiants optionnels (déjà couverts par DATABASE_URL)
DATABASE_NAME=dbname
DATABASE_USER=user
DATABASE_PASSWORD=password

# Secret JWT obligatoire (générer ex: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# Durée de validité des tokens (defaut: 24h)
JWT_EXPIRES_IN=24h

# Port HTTP (defaut: 8080)
PORT=8080

# Origines autorisées pour le CORS, séparées par des virgules
# ex: https://mon-front.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000